# Server
PORT=5000
NODE_ENV=development

# Database - leave empty in development to auto-start an in-memory MongoDB.
# Required in production, e.g. mongodb+srv://user:pass@cluster/tn-seo
MONGO_URI=

# Auth - generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (must match the Vite dev server)
CLIENT_URL=http://localhost:5173

# Google sign-in (Google Cloud Console -> OAuth 2.0 Client ID, type: Web application)
# Leave empty to hide/fail Google sign-in gracefully.
GOOGLE_CLIENT_ID=

# Optional SMTP for real password-reset emails.
# Leave empty in development: the reset link is logged to the server console
# and returned to the browser instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
